# ====== API Keys ======
# 每个 provider 的 KEY 必填：模型按其 provider 路由到对应 {PROVIDER}_API_KEY /
# {PROVIDER}_BASE_URL。若某 provider 的 KEY 为空或仍是占位（如下面的
# sk-your-...），切换/执行该 provider 的模型会被网关拒绝返回 401——这是「切换
# 模型 401 / DAG 换模型没真换」类问题的首要排查点。系统会在切换/运行态回传
# 「provider X 缺少 api_key/base_url」的可读归因（不回显 key 值）。
#
# 占位识别：形如 sk-xxx / sk-your-... 的短串（≤16 字符的 sk- 开头）会被判为
# 「占位/未配置」，等同未填。LANGFUSE_SECRET_KEY 占位会导致 trace 导出 401、
# trace 链接 404（trace 从未写入）——与模型 401 同源。
#
# 自检：启动后端时若有未配置/占位凭据，日志会打一条
#   WARNING app.main: credential health: openai=placeholder, ...
# 也可在前端工作台「监控」面板看「凭据健康」区块。命令行自检：
#   cd backend && python -c "from app.core.credential_health import unhealthy_summary; print(unhealthy_summary() or 'all credentials ok')"
# OpenAI / OpenAI-compatible (used by LLM-as-a-Judge default: provider=openai, model=gpt-5.4)
OPENAI_API_KEY=sk-your-openai-api-key
# If gpt-5.4 is served via a compatible gateway instead of api.openai.com, set this:
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# GLM (智谱) - OpenAI-compatible endpoint
GLM_API_KEY=sk-your-glm-api-key
GLM_BASE_URL=http://your-endpoint:3001/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ====== Langfuse ======
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ====== Runtime mode ======
# development | staging | production. production MUST set a non-SQLite DATABASE_URL.
APP_ENV=development

# ====== Primary database ======
# 三种 dev 启动路径：
# 1) 开箱即启（默认）：DATABASE_URL 留空 → dev 自动回落本地 SQLite
#    （backend/data/agent_factory.db），无需任何外部 DB，一句 uvicorn 即可起。
# 2) 本地接专用 postgres：先 `docker compose -f docker-compose.dev.yml up -d postgres`
#    拉起宿主 5432，再取消下一行注释（库名/账号见 compose 的 POSTGRES_* 默认值）。
#    注意：mem0 的 pgvector（若在跑）暴露在 :8432，那是 mem0 的库、不是本项目库，
#    切勿把 DATABASE_URL 指向它，否则会把本项目的表建进 mem0 的存储。
# 3) 生产：APP_ENV=production 时 MUST 显式设非 SQLite 的 DATABASE_URL（否则启动报错）。
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentgateway
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentgateway

# ====== Redis (short-term cache / locks / job queue) ======
# ENABLE_REDIS=false → working state / locks / job queue 全部回落进程内，行为与
# 未接 Redis 时完全一致（单进程语义；多 worker 部署下不共享，需开 Redis）。
# ENABLE_REDIS=true 但 REDIS_URL 连不上 → 启动期降级回落进程内并记 WARNING，不崩。
ENABLE_REDIS=false
# REDIS_URL=redis://localhost:6379/0
# 所有 Redis key 以该前缀命名空间，避免与同实例其他租户撞键。
REDIS_PREFIX=agentgw

# ====== Object storage (MinIO / S3) ======
# ENABLE_MINIO=false → 附件 / 产物落本地磁盘（data/object-store/...），preview_url
# 走 API 代理读，行为与未接对象存储时一致。
# ENABLE_MINIO=true 但 S3_ENDPOINT 不可达 → 启动期降级回落本地磁盘并记 WARNING。
# 凭据仅经 S3_ACCESS_KEY / S3_SECRET_KEY 环境变量注入，不入库；presign URL 短期有效。
ENABLE_MINIO=false
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=__set_via_env_only__
# S3_SECRET_KEY=__set_via_env_only__
S3_BUCKET_ATTACHMENTS=planner-attachments
S3_BUCKET_ARTIFACTS=agent-artifacts
S3_BUCKET_KNOWLEDGE=knowledge-assets
S3_BUCKET_EVALUATION=evaluation-reports
S3_REGION=us-east-1
S3_USE_SSL=false

# ====== Long-term memory provider ======
# none | pgonly | mem0. Default off (none); mem0 also requires ENABLE_MEM0=true.
MEMORY_PROVIDER=none
MEMORY_ENABLED_DEFAULT=false
ENABLE_MEM0=false
# MEM0_BASE_URL=http://localhost:3001
# MEM0_API_KEY=__set_via_env_only__

# ====== Async worker / job queue ======
# inprocess | redis. inprocess: jobs 仅入库为 pending、不入队、不阻塞主链路，等
# worker 批次消费（本阶段无独立 worker 进程）。redis: 额外把轻量信封推到 Redis 队列。
# 两种 provider 的入队都以 (source_kind, source_ref, job_type) 幂等去重。
JOB_QUEUE_PROVIDER=inprocess
WORKER_CONCURRENCY=1

