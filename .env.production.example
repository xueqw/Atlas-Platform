ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://atlas:{password}@127.0.0.1:5432/atlas
DATABASE_PASSWORD_FILE=/etc/atlas/secrets/postgres_password
REDIS_URL=redis://default:{password}@127.0.0.1:6379/0
REDIS_PASSWORD_FILE=/etc/atlas/secrets/redis_password
REDIS_REQUIRED=true

OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_REQUIRED=true
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=atlas
OBJECT_STORAGE_SECRET_KEY_FILE=/etc/atlas/secrets/minio_root_password
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_BUCKET=atlas
AGENT_CODE_ROOT=/var/lib/atlas/agent-code
SECRET_ENCRYPTION_KEY_FILE=/etc/atlas/secrets/secret_encryption_key

CODE_RUNNER_BACKEND=docker
CODE_RUNNER_REQUIRED=true
CODE_RUNNER_IMAGE=atlas-agent-runner:py311
CODE_RUNNER_TIMEOUT_SECONDS=10
CODE_RUNNER_MEMORY=256m
CODE_RUNNER_CPUS=0.5
CODE_RUNNER_PIDS_LIMIT=64

SHORT_MEMORY_TTL_SECONDS=86400
LONG_MEMORY_DEFAULT_TTL_DAYS=365
BACKUP_RETENTION_DAYS=14
